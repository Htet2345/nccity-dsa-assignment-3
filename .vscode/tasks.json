{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build bank",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "Run bank",
      "type": "process",
      "command": "${workspaceFolder}/build/bank.exe",
      "dependsOn": "Build bank",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"focus": true, "panel": "dedicated"}
    },
    {
      "label": "Test bank",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Test"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    }
  ]
}
